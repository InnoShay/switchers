{
  "name": "RoomService Life",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "roomservice-life",
        "authentication": "headerAuth",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000001",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0],
      "webhookId": "roomservice-life"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "f1", "name": "text", "value": "={{ $json.body.text }}", "type": "string" },
            { "id": "f2", "name": "sender_name", "value": "={{ $json.body.sender_name }}", "type": "string" },
            { "id": "f3", "name": "room_name", "value": "={{ $json.body.room_name }}", "type": "string" },
            { "id": "f4", "name": "mission_slug", "value": "={{ $json.body.mission_slug }}", "type": "string" },
            { "id": "f5", "name": "now_iso", "value": "={{ $json.body.now_iso }}", "type": "string" },
            { "id": "f6", "name": "tz", "value": "={{ $json.body.tz }}", "type": "string" },
            { "id": "f7", "name": "mode", "value": "={{ $json.body.mode }}", "type": "string" }
          ]
        },
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000002",
      "name": "Edit Fields",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [220, 0]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.text }}",
        "options": {
          "systemMessage": "=You are Life, RoomService's calendar and email agent. Owner time zone: {{ $json.tz }}.\nNow: {{ $json.now_iso }}. You can read and create Google Calendar events, read recent\nGmail messages, and create Gmail DRAFTS. You must never send email. Reply in at most\n4 short lines. If you created something, end with \"LINK: <url>\".\nIf mode is \"brief\": today's events, then the 3 most important unread emails.\nMode: {{ $json.mode }}"
        }
      },
      "id": "a1000000-0000-4000-8000-000000000003",
      "name": "AI Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [440, 0]
    },
    {
      "parameters": {
        "model": { "__rl": true, "mode": "list", "value": "claude-sonnet-4-5" },
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000004",
      "name": "Anthropic Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatAnthropic",
      "typeVersion": 1.3,
      "position": [320, 240]
    },
    {
      "parameters": {
        "sessionIdType": "customKey",
        "sessionKey": "={{ $('Edit Fields').item.json.room_name }}",
        "contextWindowLength": 10
      },
      "id": "a1000000-0000-4000-8000-000000000005",
      "name": "Simple Memory",
      "type": "@n8n/n8n-nodes-langchain.memoryBufferWindow",
      "typeVersion": 1.3,
      "position": [480, 240]
    },
    {
      "parameters": {
        "operation": "getAll",
        "calendar": { "__rl": true, "mode": "list", "value": "primary" },
        "returnAll": false,
        "limit": 20,
        "timeMin": "={{ $fromAI('start_iso', 'Start of the time range, ISO 8601', 'string') }}",
        "timeMax": "={{ $fromAI('end_iso', 'End of the time range, ISO 8601', 'string') }}",
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000006",
      "name": "Calendar: Get Many",
      "type": "n8n-nodes-base.googleCalendarTool",
      "typeVersion": 1.3,
      "position": [640, 240]
    },
    {
      "parameters": {
        "calendar": { "__rl": true, "mode": "list", "value": "primary" },
        "start": "={{ $fromAI('start_iso', 'Event start, ISO 8601', 'string') }}",
        "end": "={{ $fromAI('end_iso', 'Event end, ISO 8601', 'string') }}",
        "additionalFields": {
          "summary": "={{ $fromAI('title', 'Event title', 'string') }}"
        }
      },
      "id": "a1000000-0000-4000-8000-000000000007",
      "name": "Calendar: Create Event",
      "type": "n8n-nodes-base.googleCalendarTool",
      "typeVersion": 1.3,
      "position": [800, 240]
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "getAll",
        "returnAll": false,
        "limit": 10,
        "filters": { "readStatus": "unread" }
      },
      "id": "a1000000-0000-4000-8000-000000000008",
      "name": "Gmail: Get Unread",
      "type": "n8n-nodes-base.gmailTool",
      "typeVersion": 2.1,
      "position": [960, 240]
    },
    {
      "parameters": {
        "resource": "draft",
        "operation": "create",
        "subject": "={{ $fromAI('subject', 'Draft subject', 'string') }}",
        "message": "={{ $fromAI('body', 'Draft body', 'string') }}",
        "options": {
          "sendTo": "={{ $fromAI('to', 'Recipient email address', 'string') }}"
        }
      },
      "id": "a1000000-0000-4000-8000-000000000009",
      "name": "Gmail: Create Draft",
      "type": "n8n-nodes-base.gmailTool",
      "typeVersion": 2.1,
      "position": [1120, 240]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { reply: $json.output } }}",
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000010",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [800, 0]
    }
  ],
  "connections": {
    "Webhook": { "main": [[{ "node": "Edit Fields", "type": "main", "index": 0 }]] },
    "Edit Fields": { "main": [[{ "node": "AI Agent", "type": "main", "index": 0 }]] },
    "AI Agent": { "main": [[{ "node": "Respond to Webhook", "type": "main", "index": 0 }]] },
    "Anthropic Chat Model": {
      "ai_languageModel": [[{ "node": "AI Agent", "type": "ai_languageModel", "index": 0 }]]
    },
    "Simple Memory": { "ai_memory": [[{ "node": "AI Agent", "type": "ai_memory", "index": 0 }]] },
    "Calendar: Get Many": { "ai_tool": [[{ "node": "AI Agent", "type": "ai_tool", "index": 0 }]] },
    "Calendar: Create Event": { "ai_tool": [[{ "node": "AI Agent", "type": "ai_tool", "index": 0 }]] },
    "Gmail: Get Unread": { "ai_tool": [[{ "node": "AI Agent", "type": "ai_tool", "index": 0 }]] },
    "Gmail: Create Draft": { "ai_tool": [[{ "node": "AI Agent", "type": "ai_tool", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1", "timezone": "Asia/Kolkata" },
  "active": false,
  "pinData": {}
}
